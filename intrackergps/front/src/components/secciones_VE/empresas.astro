---
import logoMicrosoft from '../../assets/img/imgs/logos/microsoft.svg';
import logoGoogle from '../../assets/img/imgs/logos/google.svg';
import logoIBM from '../../assets/img/imgs/logos/ibm.svg';
import logoFacebook from '../../assets/img/imgs/logos/facebook.svg';
---

<section class="page-section bg-light" id="empresas">
    <div class="py-5">
        <div class="container">
            <div class="text-center">
                <h2 class="section-heading text-uppercase">Empresas</h2>
                <h3 class="section-subheading text-muted">Empresas que Conf&iacute;an en Nosotros</h3>
            </div>
            <div class="row align-items-center">
                <div class="col-md-3 col-sm-6 my-3">
                    <a href="#!"><img class="img-fluid img-brand d-block mx-auto" src={logoMicrosoft.src} alt="..." aria-label="Microsoft Logo" /></a>
                </div>
                <div class="col-md-3 col-sm-6 my-3">
                    <a href="#!"><img class="img-fluid img-brand d-block mx-auto" src={logoGoogle.src} alt="..." aria-label="Google Logo" /></a>
                </div>
                <div class="col-md-3 col-sm-6 my-3">
                    <a href="#!"><img class="img-fluid img-brand d-block mx-auto" src={logoFacebook.src} alt="..." aria-label="Facebook Logo" /></a>
                </div>
                <div class="col-md-3 col-sm-6 my-3">
                    <a href="#!"><img class="img-fluid img-brand d-block mx-auto" src={logoIBM.src} alt="..." aria-label="IBM Logo" /></a>
                </div>
            </div>
        </div>
    </div>
</section>